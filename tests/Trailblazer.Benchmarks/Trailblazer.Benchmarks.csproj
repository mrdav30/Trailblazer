<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LangVersion>11.0</LangVersion>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <NoWarn>$(NoWarn);CA1018;CA5351;CA1825</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Configurations>Debug;Release;ReleaseLean</Configurations>
    <DisableMemoryPack Condition="'$(DisableMemoryPack)' == ''">false</DisableMemoryPack>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'ReleaseLean'">
    <DisableMemoryPack>true</DisableMemoryPack>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Trailblazer\Trailblazer.csproj"
                      Condition="'$(UseLocalLsfStack)' != 'true' Or '$(UsePrebuiltLocalLsfStack)' != 'true'" />
    <ProjectReference Include="..\..\..\GridForge\src\GridForge\GridForge.csproj"
                      Condition="'$(UseLocalLsfStack)' == 'true' And '$(UsePrebuiltLocalLsfStack)' != 'true'"
                      Targets="GetTargetPath"
                      AdditionalProperties="Configuration=$(Configuration);SemVer=9.1.0;AssemblySemVer=9.1.0.0" />
    <ProjectReference Include="..\..\..\SwiftCollections\src\SwiftCollections\SwiftCollections.csproj"
                      Condition="'$(UseLocalLsfStack)' == 'true' And '$(UsePrebuiltLocalLsfStack)' != 'true'"
                      AdditionalProperties="Configuration=$(Configuration);SemVer=7.0.0;AssemblySemVer=7.0.0.0" />
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- The Test SDK is required only for the VSTest Adapter to work -->
  </ItemGroup>
  <!-- Generated BenchmarkDotNet projects consume the already-verified local build.
       This prevents nested project-reference builds from overwriting versioned LSF binaries. -->
  <ItemGroup Condition="'$(UseLocalLsfStack)' == 'true' And '$(UsePrebuiltLocalLsfStack)' == 'true'">
    <Reference Include="Trailblazer" HintPath="..\..\src\Trailblazer\bin\$(Configuration)\net8.0\Trailblazer.dll" Private="true" />
    <Reference Include="GridForge" HintPath="..\..\..\GridForge\src\GridForge\bin\$(Configuration)\net8.0\GridForge.dll" Private="true" />
    <Reference Include="FixedMathSharp" HintPath="..\..\..\FixedMathSharp\src\FixedMathSharp\bin\$(Configuration)\net8.0\FixedMathSharp.dll" Private="true" />
    <Reference Include="SwiftCollections" HintPath="..\..\..\SwiftCollections\src\SwiftCollections\bin\$(Configuration)\net8.0\SwiftCollections.dll" Private="true" />
    <Reference Include="SwiftCollections.FixedMathSharp" HintPath="..\..\..\SwiftCollections\src\SwiftCollections.FixedMathSharp\bin\$(Configuration)\net8.0\SwiftCollections.FixedMathSharp.dll" Private="true" />
    <Reference Include="Chronicler" HintPath="$(MSBuildThisFileDirectory)bin\$(Configuration)\net8.0\Chronicler.dll" Private="true" />
    <Reference Include="MemoryPack.Core" HintPath="$(MSBuildThisFileDirectory)bin\$(Configuration)\net8.0\MemoryPack.Core.dll" Private="true" />
  </ItemGroup>
  <ItemGroup>
    <None Remove=".gitignore" />
  </ItemGroup>
</Project>
