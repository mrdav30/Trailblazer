<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <NoWarn>$(NoWarn);CA1018;CA5351;CA1825</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Configurations>Debug;Release;ReleaseLean</Configurations>
    <DisableMemoryPack Condition="'$(DisableMemoryPack)' == ''">false</DisableMemoryPack>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'ReleaseLean'">
    <DisableMemoryPack>true</DisableMemoryPack>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Trailblazer\Trailblazer.csproj"
                      Condition="'$(UseLocalLsfStack)' != 'true' Or '$(UsePrebuiltLocalLsfStack)' != 'true'">
      <AdditionalProperties Condition="'$(UseLocalLsfStack)' == 'true'">Configuration=$(Configuration)</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="..\..\src\Trailblazer.Gravitas\Trailblazer.Gravitas.csproj"
                      Condition="'$(UseLocalLsfStack)' != 'true' Or '$(UsePrebuiltLocalLsfStack)' != 'true'"
                      AdditionalProperties="Configuration=$(Configuration)" />
    <ProjectReference Include="..\..\..\Gravitas\src\Gravitas\Gravitas.csproj"
                      Condition="'$(UseLocalLsfStack)' == 'true' And '$(UsePrebuiltLocalLsfStack)' != 'true'"
                      AdditionalProperties="Configuration=$(Configuration);$(LocalLsfGravitasProperties)" />
    <ProjectReference Include="..\..\..\GridForge\src\GridForge\GridForge.csproj"
                      Condition="'$(UseLocalLsfStack)' == 'true' And '$(UsePrebuiltLocalLsfStack)' != 'true'"
                      Targets="GetTargetPath"
                      AdditionalProperties="Configuration=$(Configuration);$(LocalLsfGridForgeProperties)" />
    <ProjectReference Include="..\..\..\SwiftCollections\src\SwiftCollections\SwiftCollections.csproj"
                      Condition="'$(UseLocalLsfStack)' == 'true' And '$(UsePrebuiltLocalLsfStack)' != 'true'"
                      AdditionalProperties="Configuration=$(Configuration);$(LocalLsfSwiftCollectionsProperties)" />
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- The Test SDK is required only for the VSTest Adapter to work -->
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalLsfStack)' == 'true' And '$(UsePrebuiltLocalLsfStack)' != 'true'">
    <ProjectReference Include="..\..\..\Chronicler\src\Chronicler\Chronicler.csproj"
      AdditionalProperties="Configuration=$(Configuration);$(LocalLsfChroniclerProperties)" />
    <!-- Suppress competing transitive package binaries at the executable host. -->
    <PackageReference Include="FixedMathSharp" Version="7.1.0"
      Condition="'$(Configuration)' != 'ReleaseLean' And '$(DisableMemoryPack)' != 'true'" ExcludeAssets="compile;runtime" />
    <PackageReference Include="FixedMathSharp.Lean" Version="7.1.0"
      Condition="'$(Configuration)' == 'ReleaseLean' Or '$(DisableMemoryPack)' == 'true'" ExcludeAssets="compile;runtime" />
    <ProjectReference Include="..\..\..\FixedMathSharp\src\FixedMathSharp\FixedMathSharp.csproj"
      AdditionalProperties="Configuration=$(Configuration);$(LocalLsfFixedMathSharpProperties)" />
    <ProjectReference Include="..\..\..\FixedMathSharp\src\FixedMathSharp.Chronicler\FixedMathSharp.Chronicler.csproj"
      AdditionalProperties="Configuration=$(Configuration);$(LocalLsfFixedMathSharpProperties)" />
  </ItemGroup>
  <!-- Generated BenchmarkDotNet projects consume the already-verified local build.
       This prevents nested project-reference builds from overwriting versioned LSF binaries. -->
  <ItemGroup Condition="'$(UseLocalLsfStack)' == 'true' And '$(UsePrebuiltLocalLsfStack)' == 'true'">
    <Reference Include="Trailblazer" HintPath="..\..\src\Trailblazer\bin\$(Configuration)\net10.0\Trailblazer.dll" Private="true" />
    <Reference Include="Trailblazer.Gravitas" HintPath="..\..\src\Trailblazer.Gravitas\bin\$(Configuration)\net10.0\Trailblazer.Gravitas.dll" Private="true" />
    <Reference Include="Gravitas" HintPath="..\..\..\Gravitas\src\Gravitas\bin\$(Configuration)\net10.0\Gravitas.dll" Private="true" />
    <Reference Include="GridForge" HintPath="..\..\..\GridForge\src\GridForge\bin\$(Configuration)\net10.0\GridForge.dll" Private="true" />
    <Reference Include="FixedMathSharp" HintPath="..\..\..\FixedMathSharp\src\FixedMathSharp\bin\$(Configuration)\net10.0\FixedMathSharp.dll" Private="true" />
    <Reference Include="FixedMathSharp.Chronicler" HintPath="..\..\..\FixedMathSharp\src\FixedMathSharp.Chronicler\bin\$(Configuration)\net10.0\FixedMathSharp.Chronicler.dll" Private="true" />
    <Reference Include="SwiftCollections" HintPath="..\..\..\SwiftCollections\src\SwiftCollections\bin\$(Configuration)\net10.0\SwiftCollections.dll" Private="true" />
    <Reference Include="SwiftCollections.FixedMathSharp" HintPath="..\..\..\SwiftCollections\src\SwiftCollections.FixedMathSharp\bin\$(Configuration)\net10.0\SwiftCollections.FixedMathSharp.dll" Private="true" />
    <Reference Include="Chronicler" HintPath="$(MSBuildThisFileDirectory)bin\$(Configuration)\net10.0\Chronicler.dll" Private="true" />
    <Reference Include="MemoryPack.Core" HintPath="$(MSBuildThisFileDirectory)bin\$(Configuration)\net10.0\MemoryPack.Core.dll" Private="true"
               Condition="'$(DisableMemoryPack)' != 'true'" />
    <Reference Include="Chronicler.MemoryPackShim" HintPath="..\..\..\Chronicler\src\Chronicler.MemoryPackShim\bin\$(Configuration)\net10.0\Chronicler.MemoryPackShim.dll" Private="true"
               Condition="'$(DisableMemoryPack)' == 'true'" />
  </ItemGroup>
  <ItemGroup>
    <None Remove=".gitignore" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalLsfStack)' == 'true' And ('$(Configuration)' == 'ReleaseLean' Or '$(DisableMemoryPack)' == 'true') And '$(UsePrebuiltLocalLsfStack)' != 'true'">
    <ProjectReference Include="..\..\..\Chronicler\src\Chronicler.MemoryPackShim\Chronicler.MemoryPackShim.csproj"
      AdditionalProperties="Configuration=$(Configuration);$(LocalLsfChroniclerProperties)" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalLsfStack)' != 'true'">
    <PackageReference Include="Chronicler.Diagnostics" Version="1.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalLsfStack)' == 'true'">
    <ProjectReference Include="..\..\..\Chronicler\src\Chronicler.Diagnostics\Chronicler.Diagnostics.csproj"
                      AdditionalProperties="Configuration=$(Configuration);$(LocalLsfChroniclerProperties)" />
  </ItemGroup>
</Project>
