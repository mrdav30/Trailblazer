<Project Sdk="Microsoft.NET.Sdk">

	<!-- General Properties -->
	<PropertyGroup>
		<LangVersion>14.0</LangVersion>
		<LangVersion Condition="'$(TargetFramework)' == 'netstandard2.1'">11.0</LangVersion>
		<TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
		<Configurations>Debug;Release;ReleaseLean</Configurations>
		<DisableMemoryPack Condition="'$(DisableMemoryPack)' == ''">false</DisableMemoryPack>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
		<Deterministic>true</Deterministic>
		<DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
	</PropertyGroup>

	<!-- Code Analysis and Documentation -->
	<PropertyGroup>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<IncludeSymbols>true</IncludeSymbols>
		<DebugType>portable</DebugType>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<DocumentationFile>bin\$(Configuration)\$(TargetFramework)\Trailblazer.xml</DocumentationFile>
	</PropertyGroup>

	<!-- Output Settings -->
	<PropertyGroup>
		<AssemblyName>Trailblazer</AssemblyName>
		<RootNamespace>Trailblazer</RootNamespace>
		<ProjectGuid>{0D2EC1AC-B1A0-4C06-B198-79FAA2B58E97}</ProjectGuid>
		<OutputPath>bin\$(Configuration)\</OutputPath>
	</PropertyGroup>

	<!-- NuGet Packaging Metadata -->
	<PropertyGroup>
		<Authors>mrdav30</Authors>
		<Description>Deterministic, framework-agnostic navigation for lockstep simulations and games. Trailblazer combines FixedMathSharp fixed-point math, GridForge-backed immutable navigation maps, unified Solid/Gas/Liquid A* and flow fields, actionable transitions, steering, turning, locomotion, heightmaps, and explicit Chronicler serialization.</Description>
		<PackageTags>pathfinding;navigation;game-development;deterministic;lockstep;fixed-point;fixedmathsharp;gridforge;voxel;astar;flow-field;steering;locomotion;simulation;dotnet</PackageTags>
		<RepositoryUrl>https://github.com/mrdav30/Trailblazer</RepositoryUrl>
		<PackageIcon>icon.png</PackageIcon>
		<PackageIconUrl>https://raw.githubusercontent.com/mrdav30/trailblazer/main/icon.png</PackageIconUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<!-- Configurations Properties -->

	<PropertyGroup Condition="'$(Configuration)' == 'ReleaseLean'">
		<DisableMemoryPack>true</DisableMemoryPack>
	</PropertyGroup>

	<PropertyGroup Condition="'$(DisableMemoryPack)' == 'true'">
		<DefineConstants>$(DefineConstants);TRAILBLAZER_DISABLE_MEMORYPACK</DefineConstants>
		<PackageId>Trailblazer.Lean</PackageId>
	</PropertyGroup>

	<PropertyGroup Condition="'$(DisableMemoryPack)' != 'true'">
		<PackageId>Trailblazer</PackageId>
	</PropertyGroup>

	<!-- Binary DocFX metadata needs the dependency closure beside each input DLL. -->
	<PropertyGroup>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<DebugSymbols>true</DebugSymbols>
		<Optimize>false</Optimize>
		<DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release' Or '$(Configuration)' == 'ReleaseLean'">
		<Optimize>true</Optimize>
		<DefineConstants>$(DefineConstants);TRACE</DefineConstants>
	</PropertyGroup>

	<!-- Dependencies and Package References -->
	<ItemGroup Condition="'$(DisableMemoryPack)' != 'true'">
		<PackageReference Include="MemoryPack" Version="1.21.4" />
		<PackageReference Include="FixedMathSharp" Version="8.0.0" Condition="'$(UseLocalLsfStack)' != 'true'" />
		<PackageReference Include="FixedMathSharp.Chronicler" Version="8.0.0" Condition="'$(UseLocalLsfStack)' != 'true'" />
		<PackageReference Include="SwiftCollections" Version="8.0.0" Condition="'$(UseLocalLsfStack)' != 'true'" />
		<PackageReference Include="SwiftCollections.FixedMathSharp" Version="8.0.0" Condition="'$(UseLocalLsfStack)' != 'true'" />
		<PackageReference Include="GridForge" Version="9.1.0" Condition="'$(UseLocalLsfStack)' != 'true'" />
		<PackageReference Include="Chronicler.Core" Version="1.0.0" Condition="'$(UseLocalLsfStack)' != 'true'" />
	</ItemGroup>

	<ItemGroup Condition="'$(DisableMemoryPack)' == 'true'">
		<PackageReference Include="FixedMathSharp.Lean" Version="8.0.0" Condition="'$(UseLocalLsfStack)' != 'true'" />
		<PackageReference Include="FixedMathSharp.Chronicler.Lean" Version="8.0.0" Condition="'$(UseLocalLsfStack)' != 'true'" />
		<PackageReference Include="SwiftCollections.Lean" Version="8.0.0" Condition="'$(UseLocalLsfStack)' != 'true'" />
		<PackageReference Include="SwiftCollections.FixedMathSharp.Lean" Version="8.0.0" Condition="'$(UseLocalLsfStack)' != 'true'" />
		<PackageReference Include="GridForge.Lean" Version="9.1.0" Condition="'$(UseLocalLsfStack)' != 'true'" />
		<PackageReference Include="Chronicler.Core.Lean" Version="1.0.0" Condition="'$(UseLocalLsfStack)' != 'true'" />
		<PackageReference Include="Chronicler.MemoryPackShim" Version="1.0.0" Condition="'$(UseLocalLsfStack)' != 'true'" />
	</ItemGroup>

	<ItemGroup Condition="'$(UseLocalLsfStack)' == 'true'">
		<ProjectReference Include="..\..\..\Chronicler\src\Chronicler\Chronicler.csproj"
			AdditionalProperties="Configuration=$(Configuration);$(LocalLsfChroniclerProperties)" />
		<ProjectReference Include="..\..\..\FixedMathSharp\src\FixedMathSharp\FixedMathSharp.csproj"
			AdditionalProperties="Configuration=$(Configuration);$(LocalLsfFixedMathSharpProperties)" />
		<ProjectReference Include="..\..\..\FixedMathSharp\src\FixedMathSharp.Chronicler\FixedMathSharp.Chronicler.csproj"
			AdditionalProperties="Configuration=$(Configuration);$(LocalLsfFixedMathSharpProperties)" />
		<ProjectReference Include="..\..\..\SwiftCollections\src\SwiftCollections\SwiftCollections.csproj"
			AdditionalProperties="Configuration=$(Configuration);$(LocalLsfSwiftCollectionsProperties)" />
		<ProjectReference Include="..\..\..\SwiftCollections\src\SwiftCollections.FixedMathSharp\SwiftCollections.FixedMathSharp.csproj"
			AdditionalProperties="Configuration=$(Configuration);$(LocalLsfSwiftCollectionsProperties)" />
		<ProjectReference Include="..\..\..\GridForge\src\GridForge\GridForge.csproj"
			AdditionalProperties="Configuration=$(Configuration);$(LocalLsfGridForgeProperties)" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
		<PackageReference Include="System.Text.Json" Version="10.0.9" />
	</ItemGroup>

	<!-- Ensure LICENSE, README, & icon files are included in the NuGet package -->
	<ItemGroup>
		<None Include="..\..\COPYRIGHT" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\NOTICE" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\icon.png" Pack="true" PackagePath="\" Visible="false" />
		<None Remove=".gitignore" />
	</ItemGroup>

	<!-- Ensure MemoryPack files are excluded when disabled -->
	<ItemGroup Condition="'$(DisableMemoryPack)' == 'true'">
		<Compile Remove="**\*.MemoryPack.cs" />
	</ItemGroup>

	<ItemGroup Condition="'$(UseLocalLsfStack)' == 'true' And ('$(Configuration)' == 'ReleaseLean' Or '$(DisableMemoryPack)' == 'true')">
		<ProjectReference Include="..\..\..\Chronicler\src\Chronicler.MemoryPackShim\Chronicler.MemoryPackShim.csproj"
		  AdditionalProperties="Configuration=$(Configuration);$(LocalLsfChroniclerProperties)" />
	</ItemGroup>

	<ItemGroup Condition="'$(UseLocalLsfStack)' != 'true'">
		<PackageReference Include="Chronicler.Diagnostics" Version="1.0.0" />
	</ItemGroup>
	<ItemGroup Condition="'$(UseLocalLsfStack)' == 'true'">
		<ProjectReference Include="..\..\..\Chronicler\src\Chronicler.Diagnostics\Chronicler.Diagnostics.csproj"
			AdditionalProperties="Configuration=$(Configuration);$(LocalLsfChroniclerProperties)" />
	</ItemGroup>
</Project>
