<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<LangVersion>14.0</LangVersion>
		<LangVersion Condition="'$(TargetFramework)' == 'netstandard2.1'">11.0</LangVersion>
		<TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
		<Configurations>Debug;Release;ReleaseLean</Configurations>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- Keep the resolved dependency closure beside the DLL for binary DocFX metadata. -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<GravitasPackageVersion Condition="'$(GravitasPackageVersion)' == ''">2.0.1</GravitasPackageVersion>
		<DisableTransitiveProjectReferences Condition="'$(UseLocalLsfStack)' == 'true'">true</DisableTransitiveProjectReferences>
	</PropertyGroup>
	<PropertyGroup>
		<Authors>mrdav30</Authors>
		<Description>Engine-agnostic Gravitas-backed 2D and 3D kinematic navigation for Trailblazer. Commits collision-accepted motion through an explicit deterministic prepare/resolve/commit host loop.</Description>
		<PackageTags>navigation;kinematic;gravitas;trailblazer;deterministic;lockstep;fixed-point</PackageTags>
		<RepositoryUrl>https://github.com/mrdav30/Trailblazer</RepositoryUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'ReleaseLean'">
		<DisableMemoryPack>true</DisableMemoryPack>
	</PropertyGroup>
	<PropertyGroup>
		<PackageId>Trailblazer.Gravitas</PackageId>
		<PackageId Condition="'$(DisableMemoryPack)' == 'true'">Trailblazer.Gravitas.Lean</PackageId>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'Release' Or '$(Configuration)' == 'ReleaseLean'">
		<Optimize>true</Optimize>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\Trailblazer\Trailblazer.csproj" AdditionalProperties="Configuration=$(Configuration)" />
		<ProjectReference Condition="'$(UseLocalLsfStack)' == 'true'" Include="..\..\..\Gravitas\src\Gravitas\Gravitas.csproj" AdditionalProperties="Configuration=$(Configuration);$(LocalLsfGravitasProperties)" />
	</ItemGroup>
	<ItemGroup Condition="'$(UseLocalLsfStack)' != 'true'">
		<PackageReference Include="Gravitas" Version="$(GravitasPackageVersion)" Condition="'$(DisableMemoryPack)' != 'true'" />
		<PackageReference Include="Gravitas.Lean" Version="$(GravitasPackageVersion)" Condition="'$(DisableMemoryPack)' == 'true'" />
		<PackageReference Include="Chronicler.Diagnostics" Version="1.0.0" />
	</ItemGroup>
	<ItemGroup Condition="'$(UseLocalLsfStack)' == 'true'">
		<ProjectReference PrivateAssets="all" Include="..\..\..\Chronicler\src\Chronicler\Chronicler.csproj" AdditionalProperties="Configuration=$(Configuration);$(LocalLsfChroniclerProperties)" />
		<!-- Compile against the coordinated sources without publishing extra direct dependencies. -->
		<ProjectReference PrivateAssets="all" Include="..\..\..\FixedMathSharp\src\FixedMathSharp\FixedMathSharp.csproj" AdditionalProperties="Configuration=$(Configuration);$(LocalLsfFixedMathSharpProperties)" />
		<ProjectReference PrivateAssets="all" Include="..\..\..\FixedMathSharp\src\FixedMathSharp.Chronicler\FixedMathSharp.Chronicler.csproj" AdditionalProperties="Configuration=$(Configuration);$(LocalLsfFixedMathSharpProperties)" />
		<ProjectReference PrivateAssets="all" Include="..\..\..\SwiftCollections\src\SwiftCollections\SwiftCollections.csproj" AdditionalProperties="Configuration=$(Configuration);$(LocalLsfSwiftCollectionsProperties)" />
		<ProjectReference PrivateAssets="all" Include="..\..\..\SwiftCollections\src\SwiftCollections.FixedMathSharp\SwiftCollections.FixedMathSharp.csproj" AdditionalProperties="Configuration=$(Configuration);$(LocalLsfSwiftCollectionsProperties)" />
		<ProjectReference PrivateAssets="all" Include="..\..\..\GridForge\src\GridForge\GridForge.csproj" AdditionalProperties="Configuration=$(Configuration);$(LocalLsfGridForgeProperties)" />
		<ProjectReference Include="..\..\..\Chronicler\src\Chronicler.Diagnostics\Chronicler.Diagnostics.csproj" AdditionalProperties="Configuration=$(Configuration);$(LocalLsfChroniclerProperties)" />
	</ItemGroup>
	<ItemGroup Condition="'$(UseLocalLsfStack)' == 'true' And ('$(Configuration)' == 'ReleaseLean' Or '$(DisableMemoryPack)' == 'true')">
		<ProjectReference Include="..\..\..\Chronicler\src\Chronicler.MemoryPackShim\Chronicler.MemoryPackShim.csproj" AdditionalProperties="Configuration=$(Configuration);$(LocalLsfChroniclerProperties)" PrivateAssets="all" />
	</ItemGroup>
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="/" />
		<None Include="../../LICENSE;../../NOTICE;../../COPYRIGHT;../../icon.png" Pack="true" PackagePath="/" />
	</ItemGroup>
</Project>
